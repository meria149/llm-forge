# Secrets
.env
.env.*
!.env.example

# Données locales : data/ est entièrement ignoré (calls.jsonl, jeux perso, etc.),
# sauf le README qui documente son contenu et le .gitkeep.
data/*
!data/README.md
!data/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
